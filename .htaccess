# Страховка на случай, если корень сайта по ошибке указан на booking/, а не на booking/public.
# Здесь нельзя писать «запретить всё»: Apache применяет этот файл и к booking/public.
# Поэтому закрываем конкретные файлы, а служебные папки закрыты своими .htaccess.
<FilesMatch "^(config.*\.php|.*\.md|.*\.sqlite|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
